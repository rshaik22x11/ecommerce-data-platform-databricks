"""
Notebook: 03_gold_optimizations_and_time_series

Purpose:
--------
Demonstrates Gold-layer optimizations, time-series analysis,
controlled backfills, schema evolution, and rollback.

This notebook does NOT modify core modeling logic.
"""

from pyspark.sql.functions import *

spark.sql("USE gold")

# ----------------------------------
# Performance Optimization
# ----------------------------------
spark.sql("""
OPTIMIZE gold.fact_order_items
ZORDER BY (product_id, seller_id)
""")

# ----------------------------------
# Time-Series Analytics (example)
# ----------------------------------
spark.sql("""
SELECT
  order_year,
  order_month,
  SUM(total_item_value) AS monthly_revenue
FROM gold.fact_order_items
GROUP BY order_year, order_month
ORDER BY order_year, order_month
""")

# ----------------------------------
# Backfill with Schema Evolution
# ----------------------------------
fact = spark.table("gold.fact_order_items")

fact_updated = fact.withColumn(
    "net_item_value",
    col("total_item_value") * lit(0.95)
)

(
    fact_updated
    .write
    .mode("overwrite")
    .format("delta")
    .option("mergeSchema", "true")
    .partitionBy("order_year", "order_month")
    .saveAsTable("gold.fact_order_items")
)

# ----------------------------------
# Rollback & Time Travel (reference)
# ----------------------------------
